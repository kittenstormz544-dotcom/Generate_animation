def apply_action_effect(image, action, frame_index, total_frames):
    """Apply simple visual effects based on action"""
    # Placeholder for actual animation effects
    # Real implementation would use ML models or keyframe animation
    
    action_lower = action.lower()
    frame = image.copy()
    
    # Simple effects
    if "walk" in action_lower:
        # Horizontal offset for walking
        direction = 1 if "left" not in action_lower else -1
        offset = int((frame_index / total_frames) * 50 * direction)
        frame = frame.transform(
            frame.size,
            Image.AFFINE,
            (1, 0, offset, 0, 1, 0),
            Image.BILINEAR
        )
    
    elif "jump" in action_lower:
        # Vertical offset for jumping
        offset = int(abs(np.sin(frame_index / total_frames * np.pi)) * 30)
        frame = frame.transform(
            frame.size,
            Image.AFFINE,
            (1, 0, 0, 0, 1, -offset),
            Image.BILINEAR
        )
    
    elif "spin" in action_lower:
        # Rotation for spinning
        angle = (frame_index / total_frames) * 360
        frame = frame.rotate(angle, expand=False, resample=Image.BILINEAR)
    
    elif "wave" in action_lower:
        # Subtle horizontal oscillation
        offset = int(np.sin(frame_index / total_frames * np.pi * 4) * 5)
        frame = frame.transform(
            frame.size,
            Image.AFFINE,
            (1, 0, offset, 0, 1, 0),
            Image.BILINEAR
        )
    
    return frame

def create_video_from_frames(frames, output_path, fps=24):
    """Create MP4 video from frames"""
    if not frames:
        print("No frames to create video")
        return False
    
    try:
        # Get frame dimensions
        frame_width, frame_height = frames[0].size
        
        # Create video writer
        fourcc = cv2.VideoWriter_fourcc(*'mp4v')
        out = cv2.VideoWriter(
            output_path,
            fourcc,
            fps,
            (frame_width, frame_height)
        )
        
        # Write frames
        for frame in frames:
            # Convert PIL image to numpy array
            frame_np = np.array(frame.convert("RGB"))
            # Convert RGB to BGR for OpenCV
            frame_bgr = cv2.cvtColor(frame_np, cv2.COLOR_RGB2BGR)
            out.write(frame_bgr)
        
        out.release()
        print(f"Video created: {output_path}")
        return True
    
    except Exception as e:
        print(f"Error creating video: {e}")
        return False

