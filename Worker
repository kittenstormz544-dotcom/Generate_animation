def generate_frames(image_path, actions, character_name, frames_per_action=72):
    """
    Generate frames for animation
    72 frames at 24fps = 3 seconds per action
    """
    try:
        base_image = Image.open(image_path).convert("RGBA")
        frames = []
        
        for action in actions:
            print(f"Generating frames for action: {action}")
            
            # Get animation prompt
            prompt = ACTION_PROMPTS.get(action.lower(), action)
            
            # For now, create simple frame variations
            # This will be replaced with actual ML model
            for i in range(frames_per_action):
                # Create a copy of the base image
                frame = base_image.copy()
                
                # Apply simple transformations based on action
                # (This is placeholder - real animation would use ML models)
                frame = apply_action_effect(frame, action, i, frames_per_action)
                
                frames.append(frame)
        
        return frames
    
    except Exception as e:
